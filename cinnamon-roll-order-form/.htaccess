# =============================================================
# Bachata Bakery — order backend .htaccess (/cinnamon-roll-order-form/)
# Protects secrets and internal paths from direct browser access.
# Only api/*.php, api/webhook/square.php and admin/ are meant to be public.
# =============================================================

# --- Block env files, schema, docs, and other non-public files ---
<FilesMatch "(^\.env|\.(example|sql|md|log|bak|ini|json|lock)$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (Square webhooks and the admin session cookie require it).
    # The X-Forwarded-Proto check avoids a loop when the CDN terminates TLS.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Internal code and files — never served directly
    RewriteRule ^(api/helpers|tests|setup|storage|emails|docs|\.claude)(/|$) - [F,L]

    # Retired endpoint from the old $6-roll form; checkout.php replaced it
    RewriteRule ^api/order\.php$ - [G,L]

    # Old Jotform-era static form (the order page lives at /order/)
    RewriteRule ^(index\.html$|assets/) - [F,L]
</IfModule>

# --- Security headers ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- PHP settings (Hostinger shared) ---
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

Options -Indexes
